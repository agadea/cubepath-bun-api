<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="stylesheet" href="/css/pico.min.css" />
  <link rel="stylesheet" href="/css/chat.css" />
  <title>Chat SSE</title>
</head>
<body>
  <main class="container">
    <h1>Chat SSE</h1>
    <form id="chat-form">
      <label for="prompt">Message</label>
      <textarea id="prompt" name="prompt" rows="3" placeholder="Type your message..."></textarea>
      <div style="display:flex;gap:8px;margin-top:8px;">
        <button type="submit">Send</button>
        <button type="button" id="cancel-btn" style="display:none;">Cancel</button>
      </div>
    </form>

    <div id="messages" class="messages" role="log" aria-live="polite"></div>
  </main>

  <script type="module">
    import { attachChatClient } from '/js/chat-client.js';
    attachChatClient();
  </script>
</body>
</html>
